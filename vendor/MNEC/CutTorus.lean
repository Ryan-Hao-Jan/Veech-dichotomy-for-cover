module

public import MNEC.LatticeTorus
public import Mathlib.Topology.Order

@[expose] public section

/-!
# A general lattice torus cut along a physical slit

An interior slit point has two banks, while an endpoint has one. The
topology is generated by the original torus open sets and one-sided
physical-plane collars. Both lattices in a later connected sum use the
same physical slit and normal, with no isogeny assumption.

This extends the bank construction from the earlier CriticalMeasure
project to arbitrary real basis lattices. All statements here are proved
from the displayed projection and bank definitions.
-/

noncomputable section

namespace MNEC.CutTorus

open LatticeTorus Set Topology

def interior (L : Lattice) (w : Plane) : Set Torus :=
  {p | ∃ t : ℝ, 0 < t ∧ t < 1 ∧ L.project (t • w) = p}

def endpoints (L : Lattice) (w : Plane) : Set Torus := {L.project 0, L.project w}

theorem interior_subset_slit (L : Lattice) (w : Plane) : interior L w ⊆ L.slitSet w := by
  rintro p ⟨t, ht, ht', rfl⟩
  exact ⟨⟨t, ht.le, ht'.le⟩, rfl⟩

theorem endpoints_subset_slit (L : Lattice) (w : Plane) : endpoints L w ⊆ L.slitSet w := by
  intro p hp
  rcases hp with rfl | hp
  · exact ⟨⟨0, by constructor <;> norm_num⟩, by simp [Lattice.arc]⟩
  · rw [Set.mem_singleton_iff] at hp
    rw [hp]
    exact ⟨⟨1, by constructor <;> norm_num⟩, by simp [Lattice.arc]⟩

theorem interior_disjoint_endpoints (L : Lattice) (w : Plane) (hw : L.EmbeddedSlit w) :
    Disjoint (interior L w) (endpoints L w) := by
  apply Set.disjoint_left.mpr
  rintro p ⟨t, ht, ht', htp⟩ hp
  have hti : t ∈ Icc (0 : ℝ) 1 := ⟨ht.le, ht'.le⟩
  rcases hp with hp | hp
  · have heq : L.arc w ⟨t, hti⟩ = L.arc w ⟨0, by constructor <;> norm_num⟩ := by
      simpa only [Lattice.arc, zero_smul] using htp.trans hp
    have he := congrArg Subtype.val (hw heq)
    exact ht.ne' he
  · rw [Set.mem_singleton_iff] at hp
    have heq : L.arc w ⟨t, hti⟩ = L.arc w ⟨1, by constructor <;> norm_num⟩ := by
      simpa only [Lattice.arc, one_smul] using htp.trans hp
    have he := congrArg Subtype.val (hw heq)
    exact ht'.ne he

def Point (L : Lattice) (w : Plane) :=
  {q : Torus × Bool // q.2 = false ∨ q.1 ∈ interior L w}

def base {L : Lattice} {w : Plane} (q : Point L w) : Torus := q.val.1
def bank {L : Lattice} {w : Plane} (q : Point L w) : Bool := q.val.2

def upper (L : Lattice) (w : Plane) (p : Torus) : Point L w := ⟨(p, false), Or.inl rfl⟩

def lower (L : Lattice) (w : Plane) (p : Torus) (hp : p ∈ interior L w) : Point L w :=
  ⟨(p, true), Or.inr hp⟩

@[simp] theorem base_upper (L : Lattice) (w : Plane) (p : Torus) : base (upper L w p) = p := rfl
@[simp] theorem bank_upper (L : Lattice) (w : Plane) (p : Torus) : bank (upper L w p) = false := rfl
@[simp] theorem base_lower (L : Lattice) (w : Plane) (p : Torus) (hp : p ∈ interior L w) :
    base (lower L w p hp) = p := rfl
@[simp] theorem bank_lower (L : Lattice) (w : Plane) (p : Torus) (hp : p ∈ interior L w) :
    bank (lower L w p hp) = true := rfl

theorem point_ext {L : Lattice} {w : Plane} {p q : Point L w}
    (hbase : base p = base q) (hbank : bank p = bank q) : p = q :=
  Subtype.ext (Prod.ext hbase hbank)

theorem bank_false_off_interior {L : Lattice} {w : Plane} (p : Point L w)
    (hp : base p ∉ interior L w) : bank p = false := p.property.resolve_right hp

theorem endpoint_unique (L : Lattice) (w : Plane) (hw : L.EmbeddedSlit w)
    (p q : Point L w) (hp : base p ∈ endpoints L w) (hbase : base p = base q) : p = q := by
  have hnot : base p ∉ interior L w := fun hi =>
    Set.disjoint_left.mp (interior_disjoint_endpoints L w hw) hi hp
  apply point_ext hbase
  rw [bank_false_off_interior p hnot, bank_false_off_interior q (hbase ▸ hnot)]

def normal (w : Plane) : Plane := (-w.2, w.1)
def sideSign (b : Bool) : ℝ := if b then -1 else 1

def bankNeighborhood (L : Lattice) (w : Plane) (a b r : ℝ) (k : Bool) : Set (Point L w) :=
  {q | (base q ∉ L.slitSet w ∧ ∃ s ∈ Ioo a b, ∃ t ∈ Ioo (0 : ℝ) r,
      L.project (s • w + (sideSign k * t) • normal w) = base q) ∨
    (bank q = k ∧ ∃ s ∈ Ioo a b, L.project (s • w) = base q)}

def generators (L : Lattice) (w : Plane) : Set (Set (Point L w)) :=
  {U | (∃ V : Set Torus, IsOpen V ∧ U = base ⁻¹' V) ∨
    ∃ a b r : ℝ, ∃ k : Bool, 0 < a ∧ a < b ∧ b < 1 ∧ 0 < r ∧
      U = bankNeighborhood L w a b r k}

instance pointTopology (L : Lattice) (w : Plane) : TopologicalSpace (Point L w) :=
  TopologicalSpace.generateFrom (generators L w)

theorem base_preimage_open (L : Lattice) (w : Plane) (V : Set Torus) (hV : IsOpen V) :
    IsOpen (base ⁻¹' V : Set (Point L w)) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl ⟨V, hV, rfl⟩)

theorem continuous_base (L : Lattice) (w : Plane) : Continuous (base : Point L w → Torus) :=
  continuous_def.mpr (base_preimage_open L w)

theorem bankNeighborhood_open (L : Lattice) (w : Plane) (a b r : ℝ) (k : Bool)
    (ha : 0 < a) (hab : a < b) (hb : b < 1) (hr : 0 < r) :
    IsOpen (bankNeighborhood L w a b r k) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inr ⟨a, b, r, k, ha, hab, hb, hr, rfl⟩)

end MNEC.CutTorus
